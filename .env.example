# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL + PostGIS connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_listing
# Max connections in the pg pool (use 1 with `npm run db:lite`)
DB_POOL_MAX=10

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Comma-separated API keys accepted in the `x-api-key` header for write endpoints.
# Leave empty to disable all writes. Generate one with: openssl rand -hex 32
API_KEYS=

# CORS: empty = disabled, * = any origin, or a comma-separated allow list
CORS_ORIGIN=http://localhost:5173

# Rate limit per client IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Set to true only when running behind a trusted reverse proxy (uses X-Forwarded-For)
TRUST_PROXY=false

# Serve Swagger UI at /docs
DOCS_ENABLED=true

# docker compose only
POSTGRES_PASSWORD=postgres
